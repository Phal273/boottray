{"name":"boottray","displayName":"Boottray","description":"Stage editor selections before they touch your files.","version":"0.1.0","publisher":"boottray","license":"MIT","repository":{"type":"git","url":"https://github.com/Phal273/boottray"},"icon":"media/boottray.png","engines":{"vscode":">=1.85.0"},"categories":["Other","Productivity"],"keywords":["diff","review","staging","safety"],"activationEvents":["onStartupFinished"],"main":"./out/extension.js","contributes":{"commands":[{"command":"boottray.open","title":"Boottray: Open"},{"command":"boottray.stageSelection","title":"Boottray: Stage Selection"}],"viewsContainers":{"activitybar":[{"id":"boottray-container","title":"Boottray","icon":"media/boottray.svg"}]},"views":{"boottray-container":[{"id":"boottray.panel","name":"Boottray","type":"webview","icon":"media/boottray.svg","when":"true"}]},"configuration":{"title":"Boottray","properties":{"boottray.showStatusBar":{"type":"boolean","default":true,"description":"Show the Boottray proposal count in the status bar."}}}},"scripts":{"build":"rm -rf dist && mkdir -p dist && cp -R site/. dist/","compile":"tsc -p ./","watch":"tsc -watch -p ./","package":"vsce package --no-dependencies","pages:build":"npm run build"},"devDependencies":{"@types/node":"^22.10.2","@types/vscode":"^1.85.0","@vscode/vsce":"^3.9.2","typescript":"^5.7.2"}}
