{
  "name": "boottray",
  "displayName": "Boottray",
  "description": "Stage editor selections before they touch your files.",
  "version": "0.0.1",
  "publisher": "boottray",
  "license": "MIT",
  "engines": { "vscode": ">=1.85.0" },
  "categories": ["Other", "Productivity"],
  "keywords": ["diff", "review", "staging", "safety"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "boottray.open", "title": "Boottray: Open" },
      { "command": "boottray.stageSelection", "title": "Boottray: Stage Selection" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "boottray-container", "title": "Boottray", "icon": "media/boottray.svg" }] },
    "views": { "boottray-container": [{ "id": "boottray.panel", "name": "Boottray", "type": "webview", "icon": "media/boottray.svg", "when": "true" }] },
    "configuration": {
      "title": "Boottray",
      "properties": {
        "boottray.showStatusBar": { "type": "boolean", "default": true, "description": "Show the Boottray proposal count in the status bar." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
